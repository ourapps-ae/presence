{
  "id": "ourapps-ae.presence",
  "name": "Presence",
  "kind": "component",
  "status": "example",
  "package": "ourapps-ae/presence",
  "version": "0.4.1",
  "ports": [
    {
      "id": "guest-identity",
      "name": "Guest identity",
      "direction": "input",
      "kind": "interface",
      "type": "ae/guest-identity",
      "version": "1.0.0",
      "required": true,
      "cardinality": "one"
    },
    {
      "id": "presence",
      "name": "Presence",
      "direction": "output",
      "kind": "interface",
      "type": "ae/presence",
      "version": "1.0.0"
    }
  ],
  "settings": [
    {
      "id": "awayAfterSeconds",
      "name": "Awayafterseconds",
      "type": "number",
      "required": false,
      "secret": false,
      "default": 30
    },
    {
      "id": "dropAfterSeconds",
      "name": "Dropafterseconds",
      "type": "number",
      "required": false,
      "secret": false,
      "default": 1800
    },
    {
      "id": "hostAbsentRule",
      "name": "Hostabsentrule",
      "type": "string",
      "required": false,
      "secret": false,
      "default": "pause"
    }
  ]
}
